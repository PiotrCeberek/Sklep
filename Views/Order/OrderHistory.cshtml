@model List<Projekt.Models.History>

@{
    ViewData["Title"] = "Historia Zamówień";
    var produkty = ViewBag.TymCarts as List<Projekt.Models.TymCart>;
    var znizki = ViewBag.Znizki as Dictionary<int, double> ?? new Dictionary<int, double>();
}

<h1>Historia Zamówień</h1>


@if (Model.Any())
{
    <div class="accordion" id="orderHistoryAccordion">
        @foreach (var history in Model)
        {
            double znizka = 0;
            if (znizki.ContainsKey(history.OrderId))
            {
                znizka = znizki[history.OrderId];
            }
            decimal discountFactor = 1 - (decimal)znizka / 100;

            <div class="accordion-item">
                <h2 class="accordion-header" id="heading_@history.HistoryId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapse_@history.HistoryId" aria-expanded="false"
                            aria-controls="collapse_@history.HistoryId">
                        Zamówienie #@history.OrderId | Data: @history.Date.ToString("g") |
                        Kwota: @Math.Round((history.Order.Total / ViewBag.Mnoznik) * discountFactor, 2) @ViewBag.Waluta |
                        Status: @history.Order.Status | Zniżka: @znizka%
                    </button>
                </h2>
                <div id="collapse_@history.HistoryId" class="accordion-collapse collapse"
                     aria-labelledby="heading_@history.HistoryId" data-bs-parent="#orderHistoryAccordion">
                    <div class="accordion-body">
                        <p><strong>Status:</strong> @history.Order.Status</p>
                        <p><strong>Zniżka:</strong> @znizka %</p>

                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Produkt</th>
                                    <th>Cena (za szt.)</th>
                                    <th>Ilość</th>
                                    <th>Razem</th>
                                </tr>
                            </thead>
                            <tbody>

                                @{
                                    var produktyZamowienia = produkty?.Where(p => p.OrderId == history.OrderId).ToList();
                                }

                                @foreach (var p in produktyZamowienia)
                                {
                                    decimal cenaPoZnizce = (p.Price / ViewBag.Mnoznik) * discountFactor;
                                    decimal razem = cenaPoZnizce * p.Quantity;

                                    <tr>
                                        <td>@p.Name</td>
                                        <td>@Math.Round(cenaPoZnizce, 2) @ViewBag.Waluta</td>
                                        <td>@p.Quantity</td>
                                        <td>@Math.Round(razem, 2) @ViewBag.Waluta</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"><strong>Razem po zniżce</strong></td>
                                    <td><strong>@Math.Round((history.Order.Total / ViewBag.Mnoznik) * discountFactor, 2) @ViewBag.Waluta</strong></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="pt-2 pb-2">
                            <div class="container">
                                <a asp-controller="GenerateFile" asp-action="Index" asp-route-nrZamowienia="@history.OrderId" class="btn btn-success btn-lg">Generuj PDF</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <p>Nie masz jeszcze żadnych zamówień.</p>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">Powrót</a>
</div>

<style>
    .accordion-button {
        font-size: 1.1rem;
        background-color: #f8f9fa;
    }

        .accordion-button:not(.collapsed) {
            color: #0d6efd;
            background-color: #e7f1ff;
        }

    .accordion-body {
        background-color: #fff;
    }
</style>
