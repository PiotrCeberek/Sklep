    <tbody>
        <div class="row">
            <!-- Niezrealizowane -->
            <div class="col-md-6">
                <h3>Niezrealizowane</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Wiadomość</th>
                            <th>Data utworzenia</th>
                            <th>Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notification in notCompletedNotifications)
                        {
                            <tr>
                                <td>@notification.Message</td>
                                <td>@notification.CreatedAt.ToString("g")</td>
                                <td>
                                    <a asp-action="ProcessOrder" asp-route-orderId="@notification.OrderId" class="btn btn-primary">Realizuj</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Zrealizowane -->
            <div class="col-md-6">
                <h3>Zrealizowane</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Wiadomość</th>
                            <th>Data utworzenia</th>
                            <th>Akcja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notification in completedNotifications)
                        {
                            <tr>
                                <td>@notification.Message</td>
                                <td>@notification.CreatedAt.ToString("g")</td>
                                <td>
                                    <a asp-action="ProcessOrder" asp-route-orderId="@notification.OrderId" class="btn btn-primary">Info</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </tbody>
</table>

