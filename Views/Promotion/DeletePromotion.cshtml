@model Projekt.Models.Promotion

@{
    ViewData["Title"] = "Usuń promocję";
}

<h1>Usuń promocję</h1>

<h3>Czy na pewno chcesz usunąć tę promocję?</h3>

<div>
    <h4>Szczegóły promocji</h4>
    <dl class="row">
        <dt class="col-sm-2">Produkt</dt>
        <dd class="col-sm-10">@Model.Product?.Name</dd>
        <dt class="col-sm-2">Nazwa</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Zniżka</dt>
        <dd class="col-sm-10">@Model.Discount%</dd>
        <dt class="col-sm-2">Data rozpoczęcia</dt>
        <dd class="col-sm-10">@Model.StartDateTime.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Data zakończenia</dt>
        <dd class="col-sm-10">@Model.EndDateTime.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="DeletePromotion" method="post">
        <input type="hidden" asp-for="PromotionId" />
        <button type="submit" class="btn btn-danger">Usuń</button>
        <a asp-action="ManagePromotions" class="btn btn-secondary">Cancel</a>
    </form>
</div>