@model List<Product>
@using Projekt.Models
@{
    ViewData["Title"] = "Shop";
    var categories = ViewData["Categories"] as List<Category>;
    var discountedProducts = ViewData["DiscountedProducts"] as List<Product>;
    var currentDate = DateTime.Now;
}

<div class="mt-3 text-center">
    <a asp-action="AllProducts" class="btn btn-warning btn-lg px-5 py-3 fs-4">Wszystkie produkty</a>
</div>

<div class="text-center">
    <h1>ZAPOZNAJ SIĘ Z NAJLEPSZYMI PRODUKTAMI!</h1>
</div>

<div class="banner-slider">
    <button class="slider-nav slider-nav-left" onclick="scrollBanners('left')">
        <i class="bi bi-chevron-left"></i>
    </button>

    <div class="banner-strip" id="discount-strip">
        @foreach (var product in Model)
        {
            var dostepnaIlosc = ViewBag.DostepneIlosci[product.ProductId];

            if (dostepnaIlosc > 0)
            {
                <div class="banner-content text-center">
                    <div class="image-container" style="position: relative; cursor: pointer;">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" style="height: 300px; width: 300px;" />
                        }
                        else
                        {
                            <div style="height:150px; display:flex; align-items:center; justify-content:center; background:#eee;">
                                Brak zdjęcia
                            </div>
                        }
                        <form asp-action="AddToCart" method="post" class="add-to-cart-form position-absolute"
                              style="display:none; top: 50%; left: 50%; transform: translate(-50%, -50%);
                                 background: rgba(255,255,255,0.95); padding: 10px; border-radius: 6px;
                                 box-shadow: 0 0 8px rgba(0,0,0,0.15); width: 140px; z-index: 10;">
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="number" name="quantity" value="1" min="1" max="@dostepnaIlosc"
                                   class="form-control form-control-sm mb-2" style="width: 100%;" />

                            <button type="submit" class="btn btn-primary btn-sm w-100">Dodaj do koszyka</button>
                        </form>
                    </div>

                    <div class="category-item">@product.Name</div>
                </div>
            }
        }
    </div>

    <button class="slider-nav slider-nav-right" onclick="scrollBanners('right')">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<style>
    .banner-content .image-container:hover .add-to-cart-form {
        display: block !important;
    }

    .banner-strip {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 10px;
        padding: 10px 0;
    }
</style>

<div class="text-center">
    <h1>KATEGORIE</h1>
</div>

<div class="category-slider">
    <button class="slider-nav slider-nav-left" onclick="scrollCategories('left')">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div class="category-strip">
        @if (categories != null && categories.Any())
        {
            foreach (var category in categories)
            {
                <a href="@Url.Action("CategoryProducts", "Shop", new { categoryId = category.CategoryId })"
                   class="category-item @(ViewData["SelectedCategoryId"] != null && (int)ViewData["SelectedCategoryId"] == category.CategoryId ? "active" : "")">
                    @if (!string.IsNullOrEmpty(category.ImagePath))
                    {
                        <img src="@category.ImagePath" alt="@category.Name" class="category-image" />
                    }
                    else
                    {
                        <div class="category-placeholder">
                            <span class="category-placeholder-text">@category.Name[0]</span>
                        </div>
                    }
                    <span>@category.Name</span>
                </a>
            }
        }
        else
        {
            <span>Brak kategorii</span>
        }
    </div>
    <button class="slider-nav slider-nav-right" onclick="scrollCategories('right')">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<style>
    .category-strip {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 10px;
        padding: 10px 0;
    }
</style>

<div class="text-center">
    <h1>PROMOCJE</h1>
</div>

<div class="discount-slider">
    <button class="slider-nav slider-nav-left" onclick="scrollDiscounted('left')">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div class="discount-strip">
        @if (discountedProducts != null && discountedProducts.Any())
        {
            foreach (var product in discountedProducts)
            {
                var activePromotion = product.Promotions?.FirstOrDefault(p => p.StartDateTime <= currentDate && p.EndDateTime >= currentDate);
                if (activePromotion != null)
                {
                    var discountPercentage = activePromotion.Discount;
                    var discountedPrice = product.Price * (1 - discountPercentage / 100);
                    <a href="@Url.Action("Details", "Shop", new { id = product.ProductId })" class="discount-item">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" class="discount-image" />
                        }
                        else
                        {
                            <div class="discount-placeholder"></div>
                        }
                        <span>@product.Name</span>
                        <div class="price-info">
                            <span class="original-price text-muted text-decoration-line-through">@Math.Round(product.Price / ViewBag.Mnoznik, 2) @ViewBag.Waluta</span>
                            <span class="discount-price text-danger">@(Math.Round(discountedPrice / @ViewBag.Mnoznik, 2)) @ViewBag.Waluta</span>
                        </div>
                    </a>
                }
            }
        }
        else
        {
            <span>Brak dostępnych promocji</span>
        }
    </div>
    <button class="slider-nav slider-nav-right" onclick="scrollDiscounted('right')">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<style>
    .discount-strip {
        display: flex;
        overflow-x: auto;
        scroll-behavior: smooth;
        gap: 10px;
        padding: 10px 0;
    }
</style>

<div class="mt-3 text-center">
    <a asp-action="Cart" class="btn btn-success">Wyświetl koszyk</a>
    <a asp-action="Favorites" class="btn btn-success">Wyświetl ulubione</a>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Store.css" asp-append-version="true" />
    <script>
        function scrollCategories(direction) {
            const strip = document.querySelector('.category-strip');
            const scrollAmount = 300;
            if (direction === 'left') {
                strip.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            } else {
                strip.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }

        function scrollBanners(direction) {
            const strip = document.querySelector('.banner-strip');
            const scrollAmount = 300;
            if (direction === 'left') {
                strip.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            } else {
                strip.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }

        function scrollDiscounted(direction) {
            const strip = document.querySelector('.discount-strip');
            const scrollAmount = 300;
            if (direction === 'left') {
                strip.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            } else {
                strip.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }
    </script>
}
