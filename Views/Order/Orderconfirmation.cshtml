@model Projekt.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";

    decimal znizkaProcent = ViewBag.UlgaProcent != null ? (decimal)ViewBag.UlgaProcent : 0m;
    decimal mnoznik = ViewBag.Mnoznik != null ? (decimal)ViewBag.Mnoznik : 1m;
    string waluta = ViewBag.Waluta ?? "";
    decimal totalPoZnizce = Model.Total * (1 - znizkaProcent / 100);
}

<h1>Podsumowanie zamówienia</h1>
<p>Dziękujemy za Twoje zamówienie!</p>

<h3>Szczegóły zamówienia</h3>
<p>Nr zamówienia: #@Model.OrderId</p>
<p>Data: @Model.OrderDate.ToString("g")</p>
<p>Status: @Model.Status</p>

@if (znizkaProcent > 0)
{
    <p><strong>Ulga:</strong> @znizkaProcent %</p>
}

<table class="table">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Cena</th>
            <th>Ilość</th>
            <th>Razem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ItemOrders)
        {
            var cenaPoZnizce = item.Price * (1 - znizkaProcent / 100);
            var razemPoZnizce = cenaPoZnizce * item.Quantity;
            <tr>
                <td>@(item.Product?.Name ?? "Produkt usunięty")</td>
                <td>@Math.Round(cenaPoZnizce / mnoznik, 2) @waluta</td>
                <td>@item.Quantity</td>
                <td>@Math.Round(razemPoZnizce / mnoznik, 2) @waluta</td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <td colspan="3"><strong>Całkowita wartość zamówienia</strong></td>
            <td><strong>@Math.Round(totalPoZnizce / mnoznik, 2) @waluta</strong></td>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" asp-controller="Home" class="btn btn-primary">Powrót do strony głównej</a>
