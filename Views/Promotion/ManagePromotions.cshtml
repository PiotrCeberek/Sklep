@model IEnumerable<Projekt.Models.Promotion>

@{
    ViewData["Title"] = "Zarządzaj promocjami";
}

<h1>Zarządzaj promocjami</h1>

<p>
    <a asp-action="AddPromotion" class="btn btn-primary">Dodaj nową promocję</a>
</p>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Nazwa promocji</th>
                <th>Zniżka (%)</th>
                <th>Data rozpoczęcia</th>
                <th>Sata zakończenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var promotion in Model)
            {
                <tr>
                    <td>@promotion.Product?.Name</td>
                    <td>@promotion.Name</td>
                    <td>@promotion.Discount%</td>
                    <td>@promotion.StartDateTime.ToString("yyyy-MM-dd")</td>
                    <td>@promotion.EndDateTime.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="EditPromotion" asp-route-id="@promotion.PromotionId" class="btn btn-sm btn-warning">Edytuj</a>
                        <a asp-action="DeletePromotion" asp-route-id="@promotion.PromotionId" class="btn btn-sm btn-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Brak aktywnych promocji.</p>
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Powrót do strony głównej</a>
</div>