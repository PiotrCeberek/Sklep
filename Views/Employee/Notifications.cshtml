@model IEnumerable<Projekt.Models.Notification>
@{
    ViewData["Title"] = "Powiadomienia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statusFilter = ViewBag.StatusFilter as bool?;


    var completedNotifications = Model.Where(n => n.IsRead).ToList();
    var notCompletedNotifications = Model.Where(n => !n.IsRead).ToList();
}

<h1>Powiadomienia</h1>
@* <form asp-action="NotificationsSelect" method="get" class="mb-3">
    <div class="form-group">
        <label for="statusFilter">Filtruj według statusu:</label>
        <select id="statusFilter" name="statusFilter" class="form-control">
            @if(statusFilter == false)
            { 
                <option value="false" selected>Niezrelizowane</option>
                <option value="ture">Zrealizowane</option>
            }
            else
            {
                <option value="false">Niezrelizowane</option>
