@model IEnumerable<Projekt.Models.Category>

@{
    ViewData["Title"] = "Kategorie";
}

<h1>Kategorie</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="CreateCategory" class="btn btn-primary">Stwórz nową kategorię</a>
</p>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Zdjęcie</th>
                <th>Nazwa</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(category.ImagePath))
                        {
                            <img src="@category.ImagePath" alt="@category.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <span>Brak obrazu</span>
                        }
                    </td>
                    <td>@category.Name</td>
                    <td>
                        <a asp-action="EditCategory" asp-route-id="@category.CategoryId" class="btn btn-sm btn-warning">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-sm btn-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Brak kategorii.</p>
}

<div class="mt-3">
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">Powrót do panelu administratora</a>
</div>