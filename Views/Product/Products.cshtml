@model IEnumerable<Projekt.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Produkty</h1>


@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Zdjęcie</th>
                <th>Nazwa</th>
                <th>Cena</th>
                <th>Kategoria</th>
                
                <th>Opis</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <span>Brak zdjęcia</span>
                        }
                    </td>
                    <td>@product.Name</td>
                    <td>@(Math.Round(product.Price / @ViewBag.Mnoznik,2)) @ViewBag.Waluta</td>
                    <td>@product.Category?.Name</td>
                    
                    <td>@product.Description</td>
                    <td>
                        <a asp-action="EditProduct" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">Edytuj</a>
                        <a asp-action="DeleteProduct" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">Usuń</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Brak produktów.</p>
}


<div class="mt-3">
    <a asp-controller="Product" asp-action="CreateProduct" class="btn btn-primary">Dodaj produkty</a>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Powrót do strony głównej</a>
</div>